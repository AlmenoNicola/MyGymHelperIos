    "tutorial.addExercise.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add exercise opens the picker: tap the muscles on the body (front and back) or the type to filter (\"Bodyweight\" shows only exercises without equipment), or search by name. Tap an exercise, set sets, reps, weight and rest and add it: a message confirms it has been added. Then you can add more. Those already in the list have a tick and a coloured background."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Aggiungi esercizio si apre la scelta: tocca i muscoli sul corpo (fronte e retro) o il tipo per filtrare (\"Corpo libero\" mostra solo gli esercizi senza attrezzi), oppure cerca per nome. Tocca un esercizio, imposta serie, ripetizioni, peso e pausa e aggiungilo: un avviso ti conferma che è stato aggiunto. Poi puoi aggiungerne altri. Quelli già nell'elenco hanno la spunta e lo sfondo colorato."
          }
        }
      }
    },
    "tutorial.addExercise.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add exercises"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi esercizi"
          }
        }
      }
    },
    "tutorial.alternative.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machine taken or missing equipment? On the start screen of an exercise press \"Do an alternative exercise\": the exercise list opens with its filters, already set to the same muscles. Pick one and do it in its place for this session only, or press \"Replace in the list\" to swap it for good."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macchina occupata o attrezzo che manca? Nella schermata di avvio di un esercizio premi \"Fai esercizio alternativo\": si apre l'elenco degli esercizi con i filtri, già impostato sugli stessi muscoli. Scegline uno e fallo al suo posto solo per questa sessione, oppure premi \"Sostituisci nell'elenco\" per cambiarlo in modo definitivo."
          }
        }
      }
    },
    "tutorial.alternative.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't do an exercise?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi fare un esercizio?"
          }
        }
      }
    },
    "tutorial.appearance.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the app's colours here: neutral like your phone (the default), dark, or the original orange and purple style. The change applies straight away."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui scegli i colori dell'app: neutri come il telefono (predefiniti), scuri oppure lo stile originale arancio e viola. Il cambio vale subito."
          }
        }
      }
    },
    "tutorial.appearance.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the look"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli l'aspetto"
          }
        }
      }
    },
    "tutorial.back" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indietro"
          }
        }
      }
    },
    "tutorial.cues.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here, in \"Voice and music\", turn the alerts (voice, sound and vibration) on or off and try them. You also choose the voice, the speed and the music: the app restarts it at the start of each set and pauses it during the explanation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui, in \"Voce e musica\", attivi o spegni gli avvisi (voce, suono e vibrazione) e li provi. Scegli anche la voce, la velocità e la musica: l'app la fa ripartire a inizio serie e la mette in pausa durante la spiegazione."
          }
        }
      }
    },
    "tutorial.cues.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice and music"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voce e musica"
          }
        }
      }
    },
    "tutorial.done" : {
      "extractionState" : "manual",
