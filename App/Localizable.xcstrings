    "alternative.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exercises for the same muscles come first: change the filters to see others. The alternative is for this session only (sets, reps and rest of the original exercise, no weight for bodyweight exercises); on the start screen you can make it permanent with \"Replace in the list\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In cima gli esercizi per gli stessi muscoli: cambia i filtri per vederne altri. L'alternativa vale solo per questa sessione (serie, ripetizioni e pausa dell'esercizio originale, senza peso per gli esercizi a corpo libero); nella schermata di avvio puoi renderla definitiva con \"Sostituisci nell'elenco\"."
          }
        }
      }
    },
    "alternative.permanentBody %@ %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In your list, %1$@ becomes %2$@ for good, with the current sets, reps, rest and weight. You can still change them with the pencil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell'elenco %1$@ diventa %2$@ in modo definitivo, con le serie, le ripetizioni, la pausa e il peso di adesso. Puoi sempre modificarli con la matita."
          }
        }
      }
    },
