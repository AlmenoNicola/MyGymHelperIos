    "tutorial.done.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strap on your phone, choose an exercise and enjoy your workout. Remember: the app does not replace personal trainers, nutritionists and doctors."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lega il telefono, scegli un esercizio e buon allenamento. Ricorda: l'app non sostituisce personal trainer, nutrizionisti e medici."
          }
        }
      }
    },
    "tutorial.done.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
