    "NSAppleMusicUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyGymHelper starts and pauses Apple Music during your workout, if you turn it on in Voice and music."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyGymHelper avvia e mette in pausa Apple Music durante l'allenamento, se lo attivi in Voce e musica."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyGymHelper reads your weight and height from Health to fill in your profile, only when you ask."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyGymHelper legge peso e altezza da Salute per compilare il tuo profilo, solo se lo chiedi tu."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyGymHelper saves your strength workouts to Health if you turn on the connection."
