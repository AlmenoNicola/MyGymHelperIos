{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper usa i sensori di movimento per contare le ripetizioni mentre ti alleni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper uses the motion sensors to count your reps while you train."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper legge peso e altezza da Salute per compilare il tuo profilo, solo se lo chiedi tu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper reads your weight and height from Health to fill in your profile, only when you ask."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper salva i tuoi allenamenti di forza in Salute, se attivi il collegamento."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper saves your strength workouts to Health if you turn on the connection."
          }
        }
      }
    },
    "NSAppleMusicUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper avvia e mette in pausa Apple Music durante l'allenamento, se lo attivi in Voce e musica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MyGymHelper starts and pauses Apple Music during your workout, if you turn it on in Voice and music."
          }
        }
      }
    }
  }
}